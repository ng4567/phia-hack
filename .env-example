FASHN-API-KEY=""
FAL_KEY=""

# Azure OpenAI / Foundry chat deployment used by the research agents.
# Auth uses AAD (service principal or DefaultAzureCredential) -- no API key.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# Service principal (preferred when non-interactive, e.g. CI or containers).
# If all three are set, these are used before DefaultAzureCredential.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Optional: enables the trend-research web_search tool (Tavily)
TAVILY_API_KEY=""
